{
  "name": "calligraphy-layout",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "dev:invite": "node --env-file=.env.local server.mjs",
    "invite:setup": "node scripts/setup-invite.mjs",
    "invite:rotate": "node scripts/setup-invite.mjs --rotate",
    "invite:off": "node scripts/setup-invite.mjs --disable",
    "test": "node --test tests/*.test.mjs",
    "corpus:build": "node scripts/build-classics.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "opencc-js": "1.4.2"
  }
}
